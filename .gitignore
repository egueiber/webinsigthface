# Segredos reais — nunca versionar. Use .env.example como referência.
.env

# Dependências do frontend — reinstala com `npm install`, não precisa versionar.
frontend/node_modules/

# Build do Next.js — gerado automaticamente a cada `npm run dev`/`npm run build`.
frontend/.next/

# Cache/bytecode do Python.
__pycache__/
*.pyc
backend/__pycache__/
backend/routes/__pycache__/
backend/services/__pycache__/

# Dados reais e sensíveis (biometria, vídeo de marcação, LGPD) — nunca versionar.
videomarcacoes/
data/
