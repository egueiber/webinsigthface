# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (já está no .gitignore) — este arquivo
# (.env.example) é o único dos dois que deve ir pro git.

# Senha do PostgreSQL — usada tanto pelo container do banco quanto pelo backend.
DB_PASSWORD=

# Chave secreta que assina os tokens de login (JWT).
# Gere uma nova com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
